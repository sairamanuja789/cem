# Single source of truth for every toolchain pin (REPRO-002, ADR-006).
# Sourced by scripts/docker-build.sh (build args) and scripts/versions.sh (checks).
# Pin rule: nothing published in the 14 days before the pin date (2026-10-09; cutoff 2026-09-25).

# --- Base image: Ubuntu 24.04 (tag noble-20260911, pushed 2026-09-18) ---
UBUNTU_BASE=ubuntu:noble-20260911@sha256:008173c23f95b170204355c12626cb5a965d779a7e1283b09e9cffbb1bf33ca3

# --- Ubuntu apt snapshot (https://snapshot.ubuntu.com); refresh deliberately, log in docs/toolchain.md ---
UBUNTU_SNAPSHOT=20260920T000000Z

# --- Ubuntu apt packages at that snapshot (noble, noble-updates, noble-security) ---
APT_CA_CERTIFICATES=20260601~24.04.1
APT_CURL=8.5.0-2ubuntu10.13
APT_GIT=1:2.43.0-1ubuntu7.3
APT_GNUPG=2.4.4-2ubuntu17.6
APT_XZ_UTILS=5.6.1+really5.4.5-1ubuntu0.3
APT_ZIP=3.0-13ubuntu0.2
APT_UNZIP=6.0-28ubuntu4.1
APT_TAR=1.35+dfsg-3ubuntu0.4
APT_PKG_CONFIG=1.8.1-2build1
APT_MAKE=4.3-4.1build2
APT_GCC_13=13.3.0-6ubuntu2~24.04.1
APT_GPP_13=13.3.0-6ubuntu2~24.04.1
APT_CLANG_18=1:18.1.3-1ubuntu1
APT_CLANG_FORMAT_18=1:18.1.3-1ubuntu1
APT_CLANG_TIDY_18=1:18.1.3-1ubuntu1
APT_CMAKE=3.28.3-1build7
APT_NINJA_BUILD=1.11.1-2
APT_CCACHE=4.9.1-1
APT_JQ=1.7.1-3ubuntu0.24.04.2
APT_CALCULIX_CCX=2.21-1

# Shared libraries the Gmsh pip wheel needs to load headless (each proven missing by ldd; nothing else added)
APT_LIBGLU1_MESA=9.0.2-1.1build1
APT_LIBGL1=1.7.0-1build1
APT_LIBXRENDER1=1:0.9.10-1.1build1
APT_LIBXCURSOR1=1:1.2.1-1build1
APT_LIBXFIXES3=1:6.0.0-2build1
APT_LIBXFT2=2.3.6-1build1
APT_LIBFONTCONFIG1=2.15.0-1.1ubuntu2
APT_LIBXINERAMA1=2:1.1.4-3build1

# --- OpenFOAM v2512 (ESI), official OpenCFD apt repository, not covered by the Ubuntu snapshot ---
# v2606 apt packages are release-candidate only (ADR-006).
OPENFOAM_VERSION=2512
OPENFOAM_DEB_VERSION=2512.0-2
OPENFOAM_REPO_URL=https://dl.openfoam.com/repos/deb
OPENFOAM_PUBKEY_URL=https://dl.openfoam.com/pubkey.gpg
OPENFOAM_PUBKEY_SHA256=e6ddd89ed33131a4fc63460cb131ae7416a2a0062b590f4237121598626edf86
OPENFOAM_PUBKEY_FPR=DC93C096174122E256DA24063386DD74948D208F

# --- Python tooling ---
UV_VERSION=0.12.18
UV_SHA256=89eadd7c76fc063887959510d5ba0ab1264dfd5f1143b925ddb73021a40acf16
PYTHON_VERSION=3.13.15

# --- Gmsh: pip wheel, installed once into /opt/gmsh-venv; T02 must reuse it ---
GMSH_VERSION=4.15.2
GMSH_WHEEL=gmsh-4.15.2-py2.py3-none-manylinux_2_24_x86_64.whl
GMSH_WHEEL_SHA256=4076a948ce22625330d1413d4982e22b5c69fc2f0f7951f5df64c778cf54108c

# --- vcpkg: release tag 2026.07.29 (builtin-baseline for T02) ---
VCPKG_TAG=2026.07.29
VCPKG_COMMIT=9e593bb18ea69cc5095e012465dcd675a822ed0d
